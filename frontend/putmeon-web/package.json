{
  "name": "putmeon-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src tests",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src tests *.json *.ts *.html *.md",
    "format:check": "prettier --check src tests *.json *.ts *.html *.md",
    "check": "npm run format:check && npm run lint && npm test && npm run build",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
